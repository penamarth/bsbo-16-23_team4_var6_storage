public class StorageExecutor
{
    private IStorage house;
    private iReposStor storbd;
    public StorageExecutor(IStorage house, iReposStor storbd)
    {
        this.house = house;
        this.storbd = storbd;
    }

    public Dictionary<Item, string> ExecuteProcess(iProcess process, string data)
    {
        process.Parse(data);
        var payload = process.ExecuteStorageLogic(house);
        storbd.SaveToPlacement(payload);
        return payload;
    }
}

public class StorageHouse
{
    private string type;
    private iDataInputStrategy inputStrategy;
    private iProcess process;
    private StorageRoot root;
    private StorageExecutor storageExecutor;
    private DocWorks docWorks;

    public StorageHouse()
    {
        root = new StorageRoot(2, 1, 2);
        var storbd = new storRepos();
        storageExecutor = new StorageExecutor(root, storbd);
        docWorks = new DocWorks(new AcceptanceDoc(), new docRepos());
        Console.WriteLine("Система склада инициализирована.");
    }

    private void getProcessType()
    {
        Console.WriteLine("Выберите процесс: 1-приемка, 2-заказ, 3-дефрагментация, 4-отгрузка");
        type = Console.ReadLine();
        process = type switch
        {
            "1" => new Acceptance(),
            "2" => new Order(),
            "3" => new Defragmentation(),
			"4" => new Shipment(),
            _ => new Acceptance()
        };
    }

    private void getInputStrategy()
    {
        Console.WriteLine("Выбор данных: 1-внешняя система, 2-QR, 3-вручную");
        string choice = Console.ReadLine();
        inputStrategy = choice switch
        {
            "1" => new ExternalSystemInput(),
            "2" => new QRCodeInput(),
            _ => new ManualInput()
        };
    }

    private string getMetaData()
    {
        Console.WriteLine("Введите текущую дату:");
        string data = Console.ReadLine() + ";";
        Console.WriteLine("Введите фамилию:");
        data += Console.ReadLine();
        return data;
    }

    public void ExecuteProcess()
    {
        getProcessType();
        getInputStrategy();
		if (type == "4")
		{
			Console.WriteLine("Перед отгрузкой выполняем приемку товаров на склад...");
			var defaultAcceptance = new Acceptance();
			string preloadData = inputStrategy.GetData(); // используем стратегию ввода
			defaultAcceptance.Parse(preloadData);
			storageExecutor.ExecuteProcess(defaultAcceptance, preloadData);
			Console.WriteLine("Приемка завершена. Товары на складе готовы к отгрузке.");
		}
        string data = inputStrategy.GetData();
		
        var payload = storageExecutor.ExecuteProcess(process, data);

        string metad = getMetaData();
        docWorks = type switch
        {
            "1" => new DocWorks(new AcceptanceDoc(), new docRepos()),
            "2" => new DocWorks(new OrderDoc(), new docRepos()),
            "3" => new DocWorks(new DefragmentationDoc(), new docRepos()),
			"4" => new DocWorks(new ShipmentDoc(), new docRepos()),
            _ => new DocWorks(new AcceptanceDoc(), new docRepos())
        };
		

        string document = docWorks.createDocument(metad, payload);
        docWorks.saveDocument(document);
        Console.WriteLine("Процесс завершён!");
    }
}
public class Shipment : iProcess
{
    private string batchId;
    private string date;
    private string customer;
    private string manager;

    private List<Item> items = new List<Item>();
    public Dictionary<Item, string> payload = new Dictionary<Item, string>();

    public void Parse(string data)
    {
        var parts = data.Split(';');
        var dict = new Dictionary<string, string>();

        foreach (var part in parts)
        {
            var kv = part.Split('=');
            if (kv.Length == 2)
                dict[kv[0]] = kv[1];
        }

        batchId = dict.ContainsKey("batch") ? dict["batch"] : "не указан";
        date = dict.ContainsKey("date") ? dict["date"] : "не указана";
        customer = dict.ContainsKey("customer") ? dict["customer"] : "не указан";
        manager = dict.ContainsKey("manager") ? dict["manager"] : "не указан";

        if (dict.ContainsKey("items"))
        {
            foreach (var item in dict["items"].Split(','))
            {
                var kv = item.Split(':');
                if (kv.Length == 2)
                {
                    items.Add(new Item
                    {
                        Name = kv[0].Trim(),
                        Quantity = kv[1].Trim()
                    });
                }
            }
        }
    }

    public Dictionary<Item, string> ExecuteStorageLogic(IStorage house)
    {
        Console.WriteLine($"Отгрузка №{batchId}");
        Console.WriteLine($"Дата: {date}");
        Console.WriteLine($"Заказчик: {customer}");
        Console.WriteLine($"Менеджер: {manager}");
        Console.WriteLine("Список товаров для отгрузки:");

        foreach (var item in items)
        {
            Console.WriteLine($"- {item.Name}, {item.Quantity}");
            // Поиск товара на складе
            string? cellAddress = house.Find(item, "");

            if (cellAddress != null)
            {
                this.payload.Add(item, cellAddress);
                Console.WriteLine($"Товар найден в: {cellAddress} и готов к отгрузке");

            }
            else
            {
                Console.WriteLine("Товар отсутствует на складе");
            }
        }
        return payload;
    }
}

