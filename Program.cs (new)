public class Item
{
    public string Name { get; set; }
    public string Quantity { get; set; }
}

public interface iProcess
{
    void Parse(string data);
    Dictionary<Item, string> ExecuteStorageLogic(IStorage house);
}

public class Acceptance : iProcess
{
    private List<Item> items = new List<Item>();
    public Dictionary<Item, string> payload = new Dictionary<Item, string>();
    private string batchId, date, producer, manager;

    public void Parse(string data)
    {
        var parts = data.Split(';');
        var dict = new Dictionary<string, string>();
        foreach (var part in parts)
        {
            var kv = part.Split('=');
            if (kv.Length == 2) dict[kv[0]] = kv[1];
        }
        batchId = dict.ContainsKey("batch") ? dict["batch"] : "";
        date = dict.ContainsKey("date") ? dict["date"] : "";
        producer = dict.ContainsKey("producer") ? dict["producer"] : "";
        manager = dict.ContainsKey("manager") ? dict["manager"] : "";

        if (dict.ContainsKey("items"))
        {
            foreach (var item in dict["items"].Split(','))
            {
                var kv = item.Split(':');
                if (kv.Length == 2)
                    items.Add(new Item { Name = kv[0].Trim(), Quantity = kv[1].Trim() });
            }
        }
    }

    public Dictionary<Item, string> ExecuteStorageLogic(IStorage house)
    {
        foreach (var item in items)
        {
            string? cellAddress = house.GetEmpty("Warehouse", item);
            if (cellAddress != null) payload.Add(item, cellAddress);
        }
        return payload;
    }
}

