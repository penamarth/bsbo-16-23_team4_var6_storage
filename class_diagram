@startuml
scale 1
!define BOUNDED_CONTEXT(name) rectangle name <<Ограниченный контекст>>
!define AGGREGATE(name) rectangle name <<Агрегат>>

skinparam <<Ограниченный контекст>>{
    roundcorner 100
    PackageTitleAlignment 30
}

BOUNDED_CONTEXT("Процессы_склада") {
    class StorageHouse {
        - type : string
        - inputStrategy : iDataInputStrategy
        - process : iProcess
        - root : StorageRoot
        - storageExecutor : StorageExecutor
        - docWorks : DocWorks
        + StorageHouse()
        - getProcessType() : void
        - getInputStrategy() : void
        - getMetaData() : string
        + ExecuteProcess() : void
    }

    class StorageExecutor {
        - house : IStorage
        - storbd : iReposStor
        + StorageExecutor(house : IStorage, storbd : iReposStor)
        + ExecuteProcess(process : iProcess, data : string) :\n Dictionary<Item,string>
    }

    interface iProcess {
        + Parse(data : string) : void
        + ExecuteStorageLogic(house : IStorage)\n : Dictionary<Item,string>
    }

    class Acceptance {
        - batchId : string
        - date : string
        - producer : string
        - manager : string
        - items : List<Item>
        - payload : Dictionary<Item,string>
        + Parse(data : string) : void
        + ExecuteStorageLogic(house : IStorage):\n Dictionary<Item,string>
    }

    class Order
    class Defragmentation
    class Checkout

    iProcess <|.. Acceptance
    iProcess <|.. Order
    iProcess <|.. Defragmentation
    iProcess <|.. Checkout

    StorageExecutor --> iProcess
    StorageHouse --> StorageExecutor 
    StorageHouse --> Acceptance

    class Item {
        + Name : string
        + Quantity : string
    }

    Acceptance o-- Item
}

BOUNDED_CONTEXT("Получение_данных") {
    interface iDataInputStrategy {
        + GetData() : string
    }

    class ExternalSystemInput {
        + GetData() : string
    }
    class QRCodeInput {
        + GetData() : string
    }
    class ManualInput {
        + GetData() : string
    }

    iDataInputStrategy <|.. ExternalSystemInput
    iDataInputStrategy <|.. QRCodeInput
    iDataInputStrategy <|.. ManualInput
    StorageHouse -up-> iDataInputStrategy
}

BOUNDED_CONTEXT("Документооборот") {
    AGGREGATE("Документы") {
        interface iDoc {
            + Create(metad : string,\n payload : Dictionary<Item,string>) : string
        }

        class DocWorks {
            - doc : iDoc
            - docbd : iReposDoc
            + DocWorks(doc : iDoc, docbd : iReposDoc)
            + createDocument(metad : string,\n payload : Dictionary<Item,string>) : string
            + saveDocument(document : string) : bool
        }
        class AcceptanceDoc {
            + Create(metad : string,\n payload : Dictionary<Item,string>) : string
        }
        class OrderDoc
        class DefragmentationDoc
        class CheckoutDoc

        iDoc <|.. AcceptanceDoc
        iDoc <|.. OrderDoc
        iDoc <|.. DefragmentationDoc
        iDoc <|.. CheckoutDoc
    }

    AGGREGATE("Хранилище_расположения") {
        interface iReposDoc {
            + SaveDocument(document : string) : bool
        }
        class docRepos {
            + docRepos()
            + SaveDocument(document : string) : bool
        }
        iReposDoc <|.. docRepos
    }

    DocWorks -> iDoc
    DocWorks --> iReposDoc
}

BOUNDED_CONTEXT("Расположение_элементов") {
    AGGREGATE("Расположение") {
        interface IStorage {
            + CanStore() : bool
            + GetEmpty(path : string) : string?
        }

        class StorageComposite {
            - children : List<IStorage>
            + CanStore() : bool
            + GetEmpty(path : string) : string?
        }

        class StorageCell {
            - id : string
            - isOccupied : bool
            + CanStore() : bool
            + GetEmpty(path : string) : string?
        }

        class StorageShelf {
            - shelfId : string
            + AddCell(cell : StorageCell) : void
            + GetEmpty(path : string) : string?
        }

        class StorageRoom {
            - roomId : string
            + AddShelf(shelf : StorageShelf) : void
            + GetEmpty(path : string) : string?
        }

        class StorageRoot {
            + StorageRoot(roomsCount : int,\n shelvesPerRoom : int, cellsPerShelf : int)
        }

        IStorage <|.. StorageCell
        IStorage <|.. StorageComposite
        StorageComposite <|-- StorageShelf
        StorageComposite <|-- StorageRoom
        StorageComposite <|-- StorageRoot
    }

    AGGREGATE("Хранилище_расположения") {
        interface iReposStor {
            + SaveToPlacement(data:\n Dictionary<Item,string>) : bool
        }
        class storRepos {
            + storRepos()
            + SaveToPlacement(data:\n Dictionary<Item,string>) : bool
        }
        iReposStor <|.. storRepos
    }

    StorageHouse  --> StorageRoot
    StorageExecutor --> IStorage
    StorageHouse  --> storRepos
    StorageExecutor --> iReposStor
    StorageHouse -- docRepos
    StorageHouse -- DocWorks
    StorageHouse --> AcceptanceDoc
}
@enduml
